{
  "schemaVersion": 1,
  "id": "syllydevrecorder",
  "version": "${version}",
  "name": "Sylly Dev Recorder",
  "description": "Opt-in, local-only screen and action recorder for SyllyAddons development.",
  "authors": [
    "2sylly"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.syllyaddons.recorder.SyllyDevRecorderClient"
    ]
  },
  "mixins": [
    "syllydevrecorder.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "wynntils": "=${supported_wynntils_version}"
  }
}
