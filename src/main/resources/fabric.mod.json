{
  "schemaVersion": 1,
  "id": "syllyaddons",
  "version": "${version}",
  "name": "Sylly Addons",
  "description": "A personal-use Wynntils companion for spell profiles and guild economy analysis.",
  "authors": [
    "2sylly"
  ],
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.syllyaddons.SyllyAddonsClient"
    ],
    "modmenu": [
      "net.syllyaddons.client.gui.SyllyModMenuApi"
    ]
  },
  "mixins": [
    "syllyaddons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "java": ">=21",
    "minecraft": "${minecraft_version}",
    "wynntils": "=${supported_wynntils_version}"
  }
}
